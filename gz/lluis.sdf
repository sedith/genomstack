<?xml version="1.0"?>
<sdf version="1.5">
<model name="tx">
    <pose>0 0 0.2 0 0 0</pose>
    <include>
        <uri>model://mrsim-tilthex</uri>
        <name>tx</name>
    </include>

    <include>
        <pose>0 0 0.075 0 0 0</pose>
        <uri>model://livox-mid360</uri>
        <name>livox</name>
    </include>
    <joint name="lidar_joint" type="fixed">
        <parent>tx::base</parent>
        <child>livox::base</child>
    </joint>

    <link name="rod">
        <pose>0.65 -0.38 -0.05 0 1.5708 -0.5236</pose>
        <!-- <pose>0.75 0 -0.05 0 1.5708 0</pose> -->

        <visual name="rod_visual">
            <geometry>
                <cylinder><radius>0.02</radius><length>1.5</length></cylinder>
            </geometry>
            <material>
                <diffuse>0.55 0.3 0.15 1</diffuse>
            </material>
        </visual>
    </link>
    <joint name="rod_joint" type="fixed">
        <parent>tx::base</parent>
        <child>rod</child>
    </joint>

</model>
</sdf>
